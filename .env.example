# Port the API listens on inside its container.
API_PORT=8080

# Optional: upper bound accepted for the `limit` query parameter (default 10000).
FIZZBUZZ_MAX_LIMIT=10000

# --- ClickHouse ---

# Required.
CLICKHOUSE_DB=fizzbuzz
CLICKHOUSE_USER=fizzbuzz
CLICKHOUSE_PASSWORD=fizzbuzz

# Optional: native protocol port (default 9000). Also used by `make migrate-*`.
CLICKHOUSE_PORT=9000

# Optional: host port published for ClickHouse's HTTP interface (default 8123).
CLICKHOUSE_HTTP_PORT=8123

# Optional: ClickHouse host as seen from your machine, used by `make migrate-*`.
CLICKHOUSE_MIGRATION_HOST=localhost
